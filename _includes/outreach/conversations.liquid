<div class="table-responsive">
  <table class="table table-sm table-borderless">
    <tbody>
      {% assign conversations = site.data.outreach.conversations | sort: 'date' | reverse %}
      {% for item in conversations %}
        <tr>
          <td class="text-nowrap" style="width: 5rem">
            <small class="text-muted">{{ item.date | date: '%Y/%m/%d' }}</small>
          </td>
          <td>
            <em>{{ item.title }}</em><br>
            <small>
              {% if item.outlet %}
                {% if item.outlet_url %}
                  <a href="{{ item.outlet_url }}" target="_blank" rel="noopener noreferrer">{{ item.outlet }}</a>
                {% else %}
                  {{ item.outlet }}
                {% endif %}
              {% else %}
                with
                {%- if item.with_url %}
                  <a href="{{ item.with_url }}" target="_blank" rel="noopener noreferrer">{{ item.with_name }}</a>
                {%- else %}
                  {{ item.with_name }}
                {%- endif %}
              {% endif %}
            </small>
            {% if item.description %}
              <div>
                <small>{{ item.description }}</small>
              </div>
            {% endif %}
            {% if item.article_url or item.video_url %}
              <div class="links">
                {% if item.article_url %}
                  <a href="{{ item.article_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm z-depth-0" role="button">
                    {{ item.article_label | default: 'Read article' }}
                  </a>
                {% endif %}
                {% if item.video_url %}
                  <a href="{{ item.video_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm z-depth-0" role="button">Video</a>
                {% endif %}
              </div>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
